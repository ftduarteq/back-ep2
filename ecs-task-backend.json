{
    "family": "tienda-backend-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::723000832551:role/LabRole",
    "taskRoleArn": "arn:aws:iam::723000832551:role/LabRole",
    "containerDefinitions": [
        {
            "name": "tienda-backend",
            "image": "723000832551.dkr.ecr.us-east-1.amazonaws.com/tienda-backend:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 3001,
                    "hostPort": 3001,
                    "protocol": "tcp"
                }
            ],
            "secrets": [
                { "name": "DB_HOST", "valueFrom": "arn:aws:ssm:us-east-1:723000832551:parameter/tienda/db/host" },
                { "name": "DB_USER", "valueFrom": "arn:aws:ssm:us-east-1:723000832551:parameter/tienda/db/user" },
                { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:723000832551:parameter/tienda/db/password" },
                { "name": "DB_NAME", "valueFrom": "arn:aws:ssm:us-east-1:723000832551:parameter/tienda/db/name" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/tienda-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}
